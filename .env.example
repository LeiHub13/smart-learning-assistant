# Docker 部署环境变量模板：复制为 .env 并填写后使用
#   cp .env.example .env
# 注意：.env 含敏感信息，不要提交到 Git

# ===== AI 模型（ai-service 使用）=====
AI_PROVIDER=deepseek
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ===== 可选：MCP 外部工具接入（Agent 联网搜索等） =====
# 默认已启用项目自带的 web-search MCP server（Bing 中文版，免 key 零依赖），无需配置。
# 设 AI_MCP_CONFIG=none 显式关闭；或传 JSON 换社区 server（质量更好，需 key）：
# AI_MCP_CONFIG={"web-search":{"command":"npx","args":["-y","tavily-mcp@latest"],"env":{"TAVILY_API_KEY":"tvly-xxxx"}}}

# ===== 后端安全（生产务必更换为随机长字符串）=====
JWT_SECRET=please-change-me-to-a-long-random-string-0123456789abcdef

# ===== MySQL（backend 与 mysql 容器共用）=====
MYSQL_ROOT_PASSWORD=123456
# DB_NAME=learning_assistant

# ===== Redis 缓存（compose 内置 la-redis，默认启用）=====
# 设为 memory 可回退进程内缓存
CACHE_MODE=redis
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===== 对象存储 MinIO（compose 内置 la-minio，默认启用）=====
# 设为 local 可回退容器内本地文件存储
STORAGE_MODE=minio
# MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MinIO 控制台（仅服务器本机访问）：http://127.0.0.1:9001

# ===== 邮件通知（默认关闭；开启后复习提醒同步发邮件）=====
# 以 QQ 邮箱为例：MAIL_HOST=smtp.qq.com，MAIL_PASSWORD 填授权码（设置-账户-开启SMTP获取）
# MAIL_ENABLED=true
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USERNAME=your@qq.com
# MAIL_PASSWORD=your-smtp-auth-code
# 587 端口示例：MAIL_PORT=587 MAIL_SSL=false MAIL_STARTTLS=true

# ===== 可选：向量库切换（默认 memory 内存实现，重启需自动重建） =====
# 设为 milvus 启用 Milvus 向量库（需以 docker compose --profile milvus up 启动 Milvus 容器组）
# 切换后首次启动或更换 Embedding 模型维度时，请调用一次 POST /api/kb/reindex 重建索引
VECTOR_MODE=memory
# MILVUS_HOST=milvus
# MILVUS_PORT=19530