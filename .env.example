# Docker 部署环境变量模板：复制为 .env 并填写后使用（chmod 600 .env）
#   cp .env.example .env
# 注意：.env 含敏感信息，不要提交到 Git

# ===== AI 模型（ai-service 使用）=====
AI_PROVIDER=agnes
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-3.0-flash
# DeepSeek 备选：AI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat

# ===== 可选：MCP 外部工具接入（Agent 联网搜索等） =====
# 默认已启用项目自带的 web-search MCP server（Bing 中文版，免 key 零依赖），无需配置。
# 设 AI_MCP_CONFIG=none 显式关闭；或传 JSON 换社区 server（质量更好，需 key）：
# AI_MCP_CONFIG={"web-search":{"command":"npx","args":["-y","tavily-mcp@latest"],"env":{"TAVILY_API_KEY":"tvly-xxxx"}}}

# ===== 后端安全（生产务必更换为随机长字符串）=====
JWT_SECRET=

# ===== MySQL（backend 与 mysql 容器共用）=====
MYSQL_ROOT_PASSWORD=
# DB_NAME=learning_assistant

# ===== Redis 缓存（compose 内置 la-redis，默认启用）=====
# 设为 memory 可回退进程内缓存
CACHE_MODE=redis
# REDIS_HOST=redis
# REDIS_PORT=6379

# ===== 对象存储 MinIO（compose 内置 la-minio，默认启用）=====
# 设为 local 可回退容器内本地文件存储
STORAGE_MODE=minio
# MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
# MinIO 控制台（仅服务器本机访问）：http://127.0.0.1:9001

# ===== 邮件：新库注册/找回密码的验证码需要 SMTP；通知邮件另由 MAIL_ENABLED 控制 =====
# 本地和 Docker 均需显式提供 SMTP 凭据；没有默认账号或授权码。
# 新库必须填写 SMTP 参数才能注册用户（以 QQ 邮箱为例，MAIL_PASSWORD 填授权码）
# MAIL_ENABLED=true
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USERNAME=your@qq.com
# MAIL_PASSWORD=your-smtp-auth-code
# 587 端口示例：MAIL_PORT=587 MAIL_SSL=false MAIL_STARTTLS=true

# ===== 知识库向量检索（ai-service 侧，RAG 链路已从 Java 迁移过来）=====
# 向量模型：硅基流动免费 BGE-M3；需单独申请硅基流动 API Key
# 更换模型后调用 POST /api/kb/reindex 重建索引，并使用新的 RAG_COLLECTION
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxxx
RAG_COLLECTION=learnassist_bge_m3
# 召回条数与重排/查询改写开关（重排会多一次 LLM 调用）
# RAG_TOP_K=5
# RAG_RERANK_ENABLED=true
# RAG_REWRITE_ENABLED=true
# 内部接口鉴权（Java ↔ ai-service 双向共用，生产必填）
INTERNAL_TOOL_TOKEN=

# 仅本地演示需要时启用固定测试账号和样例数据；生产保持 false
# DEMO_SEED_ENABLED=false
# 管理员按用户名白名单判定；新库先注册普通账号，再把用户名加入这里并重建 backend 容器
# ADMIN_USERNAMES=admin

# 应用镜像的本地命名前缀。默认值保留 ghcr.io 格式仅用于本机 tag 与回滚；
# deploy.sh 在服务器构建应用镜像，不会向 GHCR 推送或从 GHCR 拉取应用镜像。
# IMAGE_PREFIX=ghcr.io/leihub13/smart-learning-assistant
