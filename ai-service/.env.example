# 模型提供商配置（任选其一，建议 Agnes AI）
AI_PROVIDER=agnes
AI_API_KEY=sk-xxxx
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-3.0-flash

# DeepSeek 示例（provider 设为 deepseek）
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# 通义千问示例（provider 设为 dashscope）
# AI_PROVIDER=dashscope
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# 服务
AI_HOST=0.0.0.0
AI_PORT=8000

# ===== RAG 检索（向量索引在本服务，chunk 正文仍以 Java t_chunk 为准）=====
# 向量化：hash（离线 128 维，默认）| dashscope（通义 text-embedding-v3）
RAG_EMBEDDING_PROVIDER=hash
# RAG_EMBEDDING_MODEL=text-embedding-v3
# RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_EMBEDDING_API_KEY=sk-xxxx    # 不填则复用 AI_API_KEY
RAG_CHROMA_DIR=./data/chroma
RAG_COLLECTION=learnassist_chunks
RAG_TOP_K=5
RAG_RERANK_CANDIDATES=20
RAG_REWRITE_ENABLED=true
RAG_RERANK_ENABLED=true
# Java 内部 API（拉取 chunk 建索引）与鉴权，需与 Java 侧 app.internal-tool-token 一致
JAVA_TOOL_BASE=http://localhost:8080
JAVA_TOOL_TOKEN=internal-tool-token
