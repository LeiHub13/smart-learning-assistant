<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 登录凭据与服务器配置不参与云备份 -->
        <exclude domain="sharedpref" path="zhixue_secure.xml" />
        <exclude domain="sharedpref" path="zhixue_prefs.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zhixue_secure.xml" />
    </device-transfer>
</data-extraction-rules>
