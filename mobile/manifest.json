{
  "name": "智能学习助手",
  "appid": "",
  "description": "智能学习助手移动端（Android / iOS）",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "vueVersion": "3",
  "locale": "zh-Hans",
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "nvueCompiler": "uni-app",
    "compilerVersion": 3,
    "softinput": { "mode": "adjustResize" },
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>"
        ]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "h5": {
    "title": "智能学习助手",
    "router": { "mode": "hash" }
  }
}
